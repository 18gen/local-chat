# The model the backend talks to: the OpenAI API for testing, or any
# OpenAI-compatible server, such as Ollama on this computer. Only fictional
# data while testing with the OpenAI API: it keeps requests up to 30 days for
# abuse monitoring. This file is git-ignored; never commit the key.

# Paste the API key after the = sign. Ollama needs none: write ollama.
LLM_API_KEY=

# The models staff can choose from, as a JSON list; the first is the default.
# With more than one, the screens show a model picker.
LLM_MODELS=["gpt-6-luna"]

# Empty for the OpenAI API. Ollama: http://127.0.0.1:11434/v1
LLM_BASE_URL=

# none, low, medium or high: lower answers faster. Ollama's Qwen models need
# none, or they think for minutes before answering.
LLM_REASONING_EFFORT=low

# For Ollama; leave empty for the OpenAI API. Ollama's Qwen models default to
# 1.5, which garbles Japanese, and 0 lets small models repeat themselves; 1
# avoids both.
LLM_PRESENCE_PENALTY=

# Caps a reply in tokens, so a model stuck repeating itself stops. A reply cut
# off this way counts as failed. Ollama honors this, not max_completion_tokens.
LLM_MAX_TOKENS=
