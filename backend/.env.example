# The model the backend talks to: the OpenAI API for testing, or any
# OpenAI-compatible server (e.g. a local one) later. Only fictional data while
# testing with the OpenAI API: it keeps requests up to 30 days for abuse
# monitoring. This file is git-ignored; never commit the key.

# Paste the API key after the = sign.
LLM_API_KEY=

LLM_MODEL=gpt-6-luna

# Empty for the OpenAI API. For a local server, e.g. http://localhost:11434/v1
LLM_BASE_URL=

# none, low, medium or high: lower answers faster. Leave empty for servers
# that don't support it.
LLM_REASONING_EFFORT=low
