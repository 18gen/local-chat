# The backend's settings in Docker; backend/.env.example explains each one.
# Copy to .env, which is git-ignored.

APP_ENV=development

# Ollama on this computer, reached from inside the container.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODELS=["qwen3.5:4b"]
LLM_REASONING_EFFORT=none
LLM_PRESENCE_PENALTY=1
LLM_MAX_TOKENS=1500
